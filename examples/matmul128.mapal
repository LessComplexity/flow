fn main() {
    // Represent the vectors as 1D arrays of length 16384, which we will treat as 128x128 matrices.
    16384 -> iota -> ta;
    ta -> map { t -> (t * 7 + 13) % 101 - 50 -> widen_f64 } -> a;
    ta -> map { t -> (t * 7 + 57) % 101 - 50 -> widen_f64 } -> b;

    // Generate the range 0..128 for the inner product fold.
    128 -> iota -> krange;

    // Compute the matrix product c = a * b, where a and b are 128x128 matrices
    ta -> map { t ->
        t / 128 -> i;
        t % 128 -> j;
        (0.0, krange) -> fold { acc, k -> acc + a[i * 128 + k] * b[k * 128 + j] }
    } -> c;

    // Print the first and last elements of the resulting matrix c.
    c[0] -> println;
    c[16383] -> println;
}

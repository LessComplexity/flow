fn zip<A, B, N>(a: [A; N], b: [B; N]) -> [(A, B); N] {
    [0..N] -> map { i ->
      (a[i], b[i])
    } -> ret;
}

fn vec_add<N: i32>(a: [i32; N], b: [i32; N]) -> [i32; 16] {
    // This
    (a, b) -> zip -> map { (x, y) ->
        x + y
    } -> ret;
}

fn main() {
  vec_add([1, 2, 3, 4], [5, 6, 7, 8]) -> print;
}

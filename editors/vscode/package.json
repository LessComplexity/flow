{
  "name": "mapal-lang",
  "displayName": "Mapal",
  "description": "Syntax highlighting and file icon for the Mapal dataflow language.",
  "version": "0.1.0",
  "publisher": "mapal-lang",
  "license": "Apache-2.0 WITH LLVM-exception",
  "engines": {
    "vscode": "^1.66.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "mapal",
        "aliases": [
          "Mapal",
          "flow"
        ],
        "extensions": [
          ".mapal"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/mapal.svg",
          "dark": "./icons/mapal.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "flow",
        "scopeName": "source.mapal",
        "path": "./syntaxes/mapal.tmLanguage.json"
      }
    ]
  }
}

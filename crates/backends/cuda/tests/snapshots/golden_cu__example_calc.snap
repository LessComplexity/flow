  int32_t t4 = o27.f0;
  int32_t t5 = o27.f1;
  o28 = o27.f2 ? t4 : t5;
  o29.f1 = o28;
  int32_t t6 = o29.f0;
  int32_t t7 = o29.f1;
  o1 = o29.f2 ? t6 : t7;
  return o1;
}


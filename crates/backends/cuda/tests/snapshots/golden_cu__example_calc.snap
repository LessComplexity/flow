// mapal-backend-cuda emitted translation unit
// build: nvcc -std=c++17 -fmad=true -arch=sm_89 prog.cu libmapal_rt.a -lpthread -ldl -lm -o prog
// DESIGN §4 (amended S24b, Sapir): -fmad=true is the product/perf default; conformance runs pin -fmad=false for oracle bit-parity. Host -march=native/-mfma stays forbidden in conformance.

#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstddef>
#include <cmath>
#include <cuda_runtime.h>

extern "C" {
void mapal_print_i32(int32_t v, bool newline);
void mapal_print_i64(int64_t v, bool newline);
void mapal_print_u8(uint8_t v, bool newline);
void mapal_print_bool(bool v, bool newline);
void mapal_print_f32(float v, bool newline);
void mapal_print_f64(double v, bool newline);
void mapal_print_str(const uint8_t* ptr, size_t len, bool newline);
// Matches the Rust `-> !` (mapal-rt/src/lib.rs): lets the compiler drop the
// dead fall-through after host guards. C++11 attribute, legal on an
// extern "C" declaration; host-only, so no device-pass concern.
[[noreturn]] void mapal_trap(uint32_t kind);
}

// --- trap flag + CUDA error protocol (DESIGN §3) ---------------------------
static unsigned int* d_trap = nullptr;

// Assert one CUDA API return; on error print to stderr and exit 102 (the
// harness-visible infra-failure class — never an R1 data point).
static void cu_check(cudaError_t err, const char* what) {
    if (err != cudaSuccess) {
        fprintf(stderr, "flow-cuda infra error at %s: %s\n", what, cudaGetErrorString(err));
        exit(102);
    }
}

// Zero the trap flag — once per process, called at main start (H→D, §2 item 3).
static void trap_init() {
    cu_check(cudaMalloc((void**)&d_trap, sizeof(unsigned int)), "cudaMalloc(d_trap)");
    cu_check(cudaMemset(d_trap, 0, sizeof(unsigned int)), "cudaMemset(d_trap)");
}

// Trap-capable launch sites call this after EVERY such kernel launch (#14:
// a provably trap-free kernel takes no trap argument and skips this
// readback): cudaGetLastError
// (exit-102 protocol), then a host-synchronizing D→H read of the flag (the
// memcpy is the sync point); nonzero kind ⇒ mapal_trap(kind - 1) on the host
// (exit 101) — the flag stores kind + 1 (0 = quiescent after trap_init's
// memset; 1 = div_zero, 2 = index_oob), decoded here to the mapal-rt kinds.
[[maybe_unused]] static void trap_check_after_launch() {
    cu_check(cudaGetLastError(), "kernel launch");
    unsigned int kind = 0;
    cu_check(cudaMemcpy(&kind, d_trap, sizeof(unsigned int), cudaMemcpyDeviceToHost),
             "cudaMemcpy(d_trap)");
    if (kind != 0) {
        mapal_trap(kind - 1);
    }
}

static const char str0[] = "20 + 6 = ";
static const char str1[] = "20 - 6 = ";
static const char str2[] = "20 * 6 = ";
static const char str3[] = "20 / 6 = ";
static const char str4[] = "20 % 6 = ";

struct FlowProd_int32_t_int32_t_int32_t {
    int32_t f0;
    int32_t f1;
    int32_t f2;
};
static_assert(sizeof(FlowProd_int32_t_int32_t_int32_t) == 12, "FlowProd_int32_t_int32_t_int32_t: abi_sizeof drift (plan-smart-arenas)");
struct FlowProd_int32_t_int32_t {
    int32_t f0;
    int32_t f1;
};
static_assert(sizeof(FlowProd_int32_t_int32_t) == 8, "FlowProd_int32_t_int32_t: abi_sizeof drift (plan-smart-arenas)");
struct FlowProd_int32_t_int32_t_bool {
    int32_t f0;
    int32_t f1;
    bool f2;
};
static_assert(sizeof(FlowProd_int32_t_int32_t_bool) == 12, "FlowProd_int32_t_int32_t_bool: abi_sizeof drift (plan-smart-arenas)");

static int32_t fn0(FlowProd_int32_t_int32_t_int32_t in);
static void mapal_main();

static int32_t fn0(FlowProd_int32_t_int32_t_int32_t in) {
  int32_t o1;
  int32_t o2;
  int32_t o3;
  int32_t o4;
  int32_t o20;
  int32_t o22;
  int32_t o24;
  int32_t o26;
  int32_t o28;
  o2 = in.f0;
  o3 = in.f1;
  o4 = in.f2;
  if ((o2 == 0)) {
    o1 = ((int32_t)((uint32_t)o3 + (uint32_t)o4));
  } else {
    if ((o2 == 1)) {
      o28 = ((int32_t)((uint32_t)o3 - (uint32_t)o4));
    } else {
      if ((o2 == 2)) {
        o26 = ((int32_t)((uint32_t)o3 * (uint32_t)o4));
      } else {
        if ((o2 == 3)) {
          if (o4 == 0) { mapal_trap(0); }
          if ((o4 == -1) && (o3 == INT32_MIN)) {
            o20 = INT32_MIN;
          } else {
            o20 = o3 / o4;
          }
          o24 = o20;
        } else {
          if (o4 == 0) { mapal_trap(0); }
          if ((o4 == -1) && (o3 == INT32_MIN)) {
            o22 = 0;
          } else {
            o22 = o3 % o4;
          }
          o24 = o22;
        }
        o26 = o24;
      }
      o28 = o26;
    }
    o1 = o28;
  }
  return o1;
}

static void mapal_main() {
  FlowProd_int32_t_int32_t_int32_t o2;
  int32_t o3;
  int32_t o6;
  FlowProd_int32_t_int32_t_int32_t o8;
  int32_t o9;
  int32_t o12;
  FlowProd_int32_t_int32_t_int32_t o14;
  int32_t o15;
  int32_t o18;
  FlowProd_int32_t_int32_t_int32_t o20;
  int32_t o21;
  int32_t o24;
  FlowProd_int32_t_int32_t_int32_t o26;
  int32_t o27;
  int32_t o30;
  o2.f0 = 0;
  o2.f1 = 20;
  o2.f2 = 6;
  o3 = fn0(o2);
  o6 = o3;
  mapal_print_str((const uint8_t*)str0, 9, false);
  mapal_print_i32(o6, true);
  o8.f0 = 1;
  o8.f1 = 20;
  o8.f2 = 6;
  o9 = fn0(o8);
  o12 = o9;
  mapal_print_str((const uint8_t*)str1, 9, false);
  mapal_print_i32(o12, true);
  o14.f0 = 2;
  o14.f1 = 20;
  o14.f2 = 6;
  o15 = fn0(o14);
  o18 = o15;
  mapal_print_str((const uint8_t*)str2, 9, false);
  mapal_print_i32(o18, true);
  o20.f0 = 3;
  o20.f1 = 20;
  o20.f2 = 6;
  o21 = fn0(o20);
  o24 = o21;
  mapal_print_str((const uint8_t*)str3, 9, false);
  mapal_print_i32(o24, true);
  o26.f0 = 4;
  o26.f1 = 20;
  o26.f2 = 6;
  o27 = fn0(o26);
  o30 = o27;
  mapal_print_str((const uint8_t*)str4, 9, false);
  mapal_print_i32(o30, true);
  return;
}

int main() {
  trap_init();
  mapal_main();
  cu_check(cudaFree(d_trap), "cudaFree(d_trap)");
  return 0;
}

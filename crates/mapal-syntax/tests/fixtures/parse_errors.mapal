// parse_errors.mapal — independent syntax-class defects (DESIGN §20 item 2).
//
// Each function isolates ONE defect so multi-error recovery is visible: a
// failure in one does not mask the others. Codes exercised: P0001 P0002 P0003
// P0004 (incl. over-u64 stray guard, source-sliced fix) P0005 P0006 P0007 P0008
// P0009 P0010 P0012. (P0011 — deep nesting — is covered in unit/proptest; a deep
// fixture file is unreadable.)

// P0012: a statement at the top level (not inside a fn).
top -> level;

// P0003: a bare expression used as a `;`-terminated statement.
fn p0003() {
    lonely;
    ok -> ret;
}

// P0004: stray guard arrow outside a guard block (W1); over-u64 discriminant so
// the source-sliced fix must NOT re-render the clamped value.
fn p0004() {
    -99999999999999999999-> x;
}

// P0005: a spaced guard arm inside a guard block (recovered as the meant arm).
fn p0005() {
    (c) -> {
        - true -> a;
        -false-> b;
    } -> ret;
}

// P0006: a non-arm statement mixed into a guard block.
fn p0006() {
    (c) -> {
        -true-> a;
        - 7 -> b;
    } -> ret;
}

// P0007: a chained comparison (level 5 is non-associative).
fn p0007() {
    a < b < c -> ret;
}

// P0008: a second `<-` binding in one statement.
fn p0008() {
    x <- a <- b;
}

// P0009: `<-` inside an expression (lexes as `i <- 1`; meant `i < -1`).
fn p0009() {
    (i<-1) -> ret;
}

// P0010: an empty block `{}` in stage position.
fn p0010() {
    x -> {};
}

// P0001: a missing parameter type (`:`-less param).
fn p0001(a) {
    a -> ret;
}

// P0002: an unclosed `{` running to end of input (unclosed delimiter at EOF).
fn p0002() {
    a -> ret;


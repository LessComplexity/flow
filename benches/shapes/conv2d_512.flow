// conv2d 3×3 (S25 tile-shape corpus): out[i,j] = Σₖ w[k]·img[(i+k/3)·514 + j+k%3]
// over a 514×514 image, 512×512 out. The k-decomposition (k/3, k%3) lives INSIDE
// the fold body, so the reads are non-affine in raw k — tile_plan must refuse
// (recorded ceiling: derived-var affine forms). bounds_proof still ranges the
// k/3 and k%3 chains, so the guards are elided even though the site is untiled.
// Perf size; oracle sibling: conv2d_16.flow.
fn main() {
    264196 -> iota -> ti;
    ti -> map { t -> (t * 7 + 13) % 101 - 50 -> widen_f32 } -> img;
    9 -> iota -> kr;
    kr -> map { t -> (t * 5 + 3) % 31 - 15 -> widen_f32 } -> w;
    262144 -> iota -> ts;
    ts -> map { t ->
        t / 512 -> i;
        t % 512 -> j;
        (0.0, kr) -> fold { acc, k -> acc + w[k] * img[(i + k / 3) * 514 + j + k % 3] }
    } -> y;
    y[0] -> println;
    y[262143] -> println;
}

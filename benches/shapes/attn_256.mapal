// Attention-shaped (S25 tile-shape corpus): S = Q·Kᵀ then O = S·V — two CHAINED
// matmul-shaped sites (no softmax: `exp` is not in the Core op set — recorded
// for Sapir). kt is stored column-major ([d][j] layout) so the score read is
// lane-stride-1 (kt[k*256+j]) — the recognizable layout; see
// attn_256_rowmajor.mapal for the refusal twin. Perf size; oracle: attn_16.mapal.
fn main() {
    65536 -> iota -> tq;
    tq -> map { t -> (t * 7 + 13) % 101 - 50 -> widen_f32 } -> q;
    tq -> map { t -> (t * 5 + 29) % 101 - 50 -> widen_f32 } -> kt;
    tq -> map { t -> (t * 3 + 41) % 101 - 50 -> widen_f32 } -> v;
    256 -> iota -> kr;
    tq -> map { t ->
        t / 256 -> i;
        t % 256 -> j;
        (0.0, kr) -> fold { acc, k -> acc + q[i * 256 + k] * kt[k * 256 + j] }
    } -> s;
    tq -> map { t ->
        t / 256 -> i;
        t % 256 -> j;
        (0.0, kr) -> fold { acc, k -> acc + s[i * 256 + k] * v[k * 256 + j] }
    } -> o;
    o[0] -> println;
    o[65535] -> println;
}

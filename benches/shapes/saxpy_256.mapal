// Oracle sibling of saxpy_1048576.mapal — same shape, interpreter-sized.
fn main() {
    256 -> iota -> ix;
    ix -> map { t -> (t * 7 + 13) % 101 - 50 -> widen_f32 } -> x;
    ix -> map { t -> (t * 5 + 3) % 31 - 15 -> widen_f32 } -> y0;
    (x, y0) -> zip -> map { p -> 2.5 * p.0 + p.1 } -> y;
    y[0] -> println;
    y[255] -> println;
}

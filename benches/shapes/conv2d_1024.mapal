// conv2d 3×3: out[i,j] = Σₖ w[k]·img[(i+k/3)·1026 + j+k%3] over a 1026×1026
// image, 1024×1024 out (S29 scale-up; small sibling conv2d_512.mapal, oracle
// conv2d_16.mapal).
fn main() {
    1052676 -> iota -> ti;
    ti -> map { t -> (t * 7 + 13) % 101 - 50 -> widen_f32 } -> img;
    9 -> iota -> kr;
    kr -> map { t -> (t * 5 + 3) % 31 - 15 -> widen_f32 } -> w;
    1048576 -> iota -> ts;
    () -> time -> t0;
    ts -> map { t ->
        t / 1024 -> i;
        t % 1024 -> j;
        (0.0, kr) -> fold { acc, k -> acc + w[k] * img[(i + k / 3) * 1026 + j + k % 3] }
    } -> y;
    () -> time -> t1;
    y[0] -> println;
    y[1048575] -> println;
    "iter ms=" -> print;
    t1 - t0 -> println;
}

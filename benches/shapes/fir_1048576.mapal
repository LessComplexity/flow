// FIR / conv1d class: y[t] = Σₖ w[k]·x[t+k], 64 taps. 1M outputs (S29 scale-up;
// small sibling fir_65536.mapal, oracle fir_256.mapal).
fn main() {
    1048639 -> iota -> tx;
    tx -> map { t -> (t * 7 + 13) % 101 - 50 -> widen_f32 } -> x;
    64 -> iota -> kr;
    kr -> map { t -> (t * 5 + 3) % 31 - 15 -> widen_f32 } -> w;
    1048576 -> iota -> ts;
    () -> time -> t0;
    ts -> map { t ->
        (0.0, kr) -> fold { acc, k -> acc + w[k] * x[t + k] }
    } -> y;
    () -> time -> t1;
    y[0] -> println;
    y[1048575] -> println;
    "iter ms=" -> print;
    t1 - t0 -> println;
}

fn main() {
    16 -> iota -> ta;
    ta -> map { t -> (t * 7 + 13) % 101 - 50 -> widen_f64 } -> a;
    ta -> map { t -> (t * 7 + 57) % 101 - 50 -> widen_f64 } -> b;
    4 -> iota -> krange;
    ta -> map { t ->
        t / 4 -> i;
        t % 4 -> j;
        (0.0, krange) -> fold { acc, k -> acc + a[i * 4 + k] * b[k * 4 + j] }
    } -> c;
    c[0] -> println;
    c[15] -> println;
}

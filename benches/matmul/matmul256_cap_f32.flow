fn main() {
    iota(65536) -> ta;
    ta -> map { t -> (t * 7 + 13) % 101 - 50 -> widen_f32 } -> a;
    ta -> map { t -> (t * 7 + 57) % 101 - 50 -> widen_f32 } -> b;
    iota(256) -> krange;
    ta -> map { t ->
        t / 256 -> i;
        t % 256 -> j;
        (0.0, krange) -> fold { acc, k -> acc + a[i * 256 + k] * b[k * 256 + j] }
    } -> c;
    c[0] -> println;
    c[65535] -> println;
}

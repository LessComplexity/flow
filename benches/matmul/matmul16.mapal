fn cell(a: [f32; 256], b: [f32; 256], i: i32, j: i32) -> f32 {
    mut k: i32   <- 0;
    mut acc: f32 <- 0.0;
    loop {
        (k < 16) -> {
            -true-> {
                acc + a[i * 16 + k] * b[k * 16 + j] -> acc;
                k + 1 -> k;
                -> loop;
            }
            -false-> acc -> ret;
        }
    }
}

fn matmul(a: [f32; 256], b: [f32; 256]) -> [f32; 256] {
    mut c: [f32; 256] <- b;
    mut t: i32       <- 0;
    loop {
        (t < 256) -> {
            -true-> {
                t / 16 -> i;
                t % 16 -> j;
                (a, b, i, j) -> cell -> v;
                c[t] <- v;
                t + 1 -> t;
                -> loop;
            }
            -false-> c -> ret;
        }
    }
}

fn main() {
    256 -> iota -> ta;
    ta -> map { t -> (t * 7 + 13) % 101 - 50 -> widen_f32 } -> a;
    ta -> map { t -> (t * 7 + 57) % 101 - 50 -> widen_f32 } -> b;
    (a, b) -> matmul -> c;
    c[0] -> println;
    c[255] -> println;
}

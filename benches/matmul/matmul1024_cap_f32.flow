fn main() {
    1048576 -> iota -> ta;
    ta -> map { t -> (t * 7 + 13) % 101 - 50 -> widen_f32 } -> a;
    ta -> map { t -> (t * 7 + 57) % 101 - 50 -> widen_f32 } -> b;
    1024 -> iota -> krange;
    () -> time -> t0;
    ta -> map { t ->
        t / 1024 -> i;
        t % 1024 -> j;
        (0.0, krange) -> fold { acc, k -> acc + a[i * 1024 + k] * b[k * 1024 + j] }
    } -> c;
    () -> time -> t1;
    c[0] -> println;
    c[1048575] -> println;
    "iter ms=" -> print;
    t1 - t0 -> println;
}

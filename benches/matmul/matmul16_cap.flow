fn main() {
    iota(256) -> ta;
    ta -> map { t -> (t * 7 + 13) % 101 - 50 -> widen_f64 } -> a;
    ta -> map { t -> (t * 7 + 57) % 101 - 50 -> widen_f64 } -> b;
    iota(16) -> krange;
    ta -> map { t ->
        t / 16 -> i;
        t % 16 -> j;
        (0.0, krange) -> fold { acc, k -> acc + a[i * 16 + k] * b[k * 16 + j] }
    } -> c;
    c[0] -> println;
    c[255] -> println;
}

fn main() {
    4194304 -> iota -> ta;
    ta -> map { t -> (t * 7 + 13) % 101 - 50 -> widen_f64 } -> a;
    ta -> map { t -> (t * 7 + 57) % 101 - 50 -> widen_f64 } -> b;
    2048 -> iota -> krange;
    ta -> map { t ->
        t / 2048 -> i;
        t % 2048 -> j;
        (0.0, krange) -> fold { acc, k -> acc + a[i * 2048 + k] * b[k * 2048 + j] }
    } -> c;
    c[0] -> println;
    c[4194303] -> println;
}

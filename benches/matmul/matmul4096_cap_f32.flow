fn main() {
    16777216 -> iota -> ta;
    ta -> map { t -> (t * 7 + 13) % 101 - 50 -> widen_f32 } -> a;
    ta -> map { t -> (t * 7 + 57) % 101 - 50 -> widen_f32 } -> b;
    4096 -> iota -> krange;
    ta -> map { t ->
        t / 4096 -> i;
        t % 4096 -> j;
        (0.0, krange) -> fold { acc, k -> acc + a[i * 4096 + k] * b[k * 4096 + j] }
    } -> c;
    c[0] -> println;
    c[16777215] -> println;
}

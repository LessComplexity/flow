fn main() {
    16384 -> iota -> ta;
    ta -> map { t -> (t * 7 + 13) % 101 - 50 -> widen_f32 } -> a;
    ta -> map { t -> (t * 7 + 57) % 101 - 50 -> widen_f32 } -> b;
    128 -> iota -> krange;
    ta -> map { t ->
        t / 128 -> i;
        t % 128 -> j;
        (0.0, krange) -> fold { acc, k -> acc + a[i * 128 + k] * b[k * 128 + j] }
    } -> c;
    c[0] -> println;
    c[16383] -> println;
}

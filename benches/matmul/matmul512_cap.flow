fn main() {
    262144 -> iota -> ta;
    ta -> map { t -> (t * 7 + 13) % 101 - 50 -> widen_f64 } -> a;
    ta -> map { t -> (t * 7 + 57) % 101 - 50 -> widen_f64 } -> b;
    512 -> iota -> krange;
    ta -> map { t ->
        t / 512 -> i;
        t % 512 -> j;
        (0.0, krange) -> fold { acc, k -> acc + a[i * 512 + k] * b[k * 512 + j] }
    } -> c;
    c[0] -> println;
    c[262143] -> println;
}

fn cell(a: [f32; 1024], b: [f32; 1024], i: i32, j: i32) -> f32 {
    mut k: i32   <- 0;
    mut acc: f32 <- 0.0;
    loop {
        (k < 32) -> {
            -true-> {
                acc + a[i * 32 + k] * b[k * 32 + j] -> acc;
                k + 1 -> k;
                -> loop;
            }
            -false-> acc -> ret;
        }
    }
}

fn matmul(a: [f32; 1024], b: [f32; 1024]) -> [f32; 1024] {
    mut c: [f32; 1024] <- b;
    mut t: i32       <- 0;
    loop {
        (t < 1024) -> {
            -true-> {
                t / 32 -> i;
                t % 32 -> j;
                (a, b, i, j) -> cell -> v;
                c[t] <- v;
                t + 1 -> t;
                -> loop;
            }
            -false-> c -> ret;
        }
    }
}


fn cell(a: [f32; 16777216], b: [f32; 16777216], i: i32, j: i32) -> f32 {
    mut k: i32   <- 0;
    mut acc: f32 <- 0.0;
    loop {
        (k < 4096) -> {
            -true-> {
                acc + a[i * 4096 + k] * b[k * 4096 + j] -> acc;
                k + 1 -> k;
                -> loop;
            }
            -false-> acc -> ret;
        }
    }
}

fn matmul(a: [f32; 16777216], b: [f32; 16777216]) -> [f32; 16777216] {
    mut c: [f32; 16777216] <- b;
    mut t: i32       <- 0;
    loop {
        (t < 16777216) -> {
            -true-> {
                t / 4096 -> i;
                t % 4096 -> j;
                (a, b, i, j) -> cell -> v;
                c[t] <- v;
                t + 1 -> t;
                -> loop;
            }
            -false-> c -> ret;
        }
    }
}

fn main() {
    16777216 -> iota -> ta;
    ta -> map { t -> (t * 7 + 13) % 101 - 50 -> widen_f32 } -> a;
    ta -> map { t -> (t * 7 + 57) % 101 - 50 -> widen_f32 } -> b;
    (a, b) -> matmul -> c;
    c[0] -> println;
    c[16777215] -> println;
}
